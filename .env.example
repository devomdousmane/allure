# Copier vers .env.local et renseigner les valeurs.
# Sur Netlify : Site configuration → Environment variables (scopes Production + Builds).

# Mapbox (carte quartier) — restreindre le token au domaine residence-allure.com
NEXT_PUBLIC_MAPBOX_TOKEN=

# Contact email (Resend) — https://resend.com
# Peut rester vide au premier déploiement : les formulaires répondront 503 jusqu’à la clé.
RESEND_API_KEY=
CONTACT_TO_EMAIL=office@residence-allure.com
# Tant que le domaine n’est pas vérifié chez Resend :
CONTACT_FROM_EMAIL="Résidence Allure <onboarding@resend.dev>"
# Puis : CONTACT_FROM_EMAIL="Résidence Allure <office@residence-allure.com>"

# URL canonique (SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://residence-allure.com

# Rate-limit API (optionnel) — Upstash Redis REST
# Sans ces vars : fallback mémoire (OK en local, faible sur serverless multi-instances)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 21st.dev Magic MCP (Cursor) — https://21st.dev
API_KEY_21ST=
